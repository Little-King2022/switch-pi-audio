#!/bin/sh /etc/rc.common
START=59
STOP=80
USE_PROCD=1

start_service() {
    [ -d /sys/class/bluetooth/hci0 ] && return 0
    local device_node tty path
    device_node=$(tr -d '\000' </proc/device-tree/aliases/bluetooth) || return 1
    device_node="/sys/firmware/devicetree/base/${device_node%/bluetooth}"
    device_node=$(readlink -f "$device_node") || return 1
    for tty in /sys/class/tty/ttyAMA*; do
        [ -e "$tty/device/of_node" ] || continue
        path=$(readlink -f "$tty/device/of_node")
        [ "$path" = "$device_node" ] || continue
        procd_open_instance
        procd_set_param command /usr/libexec/switch-audio-hciattach "/dev/${tty##*/}"
        procd_set_param respawn 3600 5 3
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
        return 0
    done
    logger -t switch-audio-uart "No tty found for the onboard Bluetooth UART"
    return 1
}
